# Required for AI Coach features (server-side only — never expose to client).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-pro. Use gemini-2.5-flash for faster/cheaper responses.
GEMINI_MODEL=gemini-2.5-pro

# Optional polite User-Agent for FPL API requests.
FPL_USER_AGENT=fpl-rival-slayer-ai/0.1 (+https://github.com/thinesrao/fpl-rival-slayer-ai)
