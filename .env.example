# Required for AI Coach features (server-side only — never expose to client).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-pro. Use gemini-2.5-flash for faster/cheaper responses.
GEMINI_MODEL=gemini-2.5-pro

# Optional User-Agent for FPL API requests. The default is a recent Chrome UA
# because FPL's bot filter 403s anything that looks like a generic HTTP client
# (custom UAs, "bot"/"crawler" strings, or anything mentioning a repo URL).
# Bump the Chrome version periodically; only override here if you have a
# specific reason.
FPL_USER_AGENT=

# Optional Upstash Redis (caches AI analyses + stores GW snapshots for retrospectives).
# Without these the app still works, but each /api/analysis call re-runs Gemini and
# the Retrospective tab is disabled. Vercel's Upstash integration also injects
# KV_REST_API_URL / KV_REST_API_TOKEN aliases, which the client picks up automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Web Push (deadline reminders + injury news alerts). Generate keys with:
#   npx web-push generate-vapid-keys
# The PUBLIC key is also exposed to the browser via NEXT_PUBLIC_VAPID_PUBLIC_KEY
# so the service worker can subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional personal-use shortcut: if BOTH are set, "/" auto-redirects to
# /dashboard/<teamId>/<leagueId>. The form also pre-fills with these values.
# Note: NEXT_PUBLIC_* values are baked into the client bundle.
NEXT_PUBLIC_DEFAULT_TEAM_ID=
NEXT_PUBLIC_DEFAULT_LEAGUE_ID=

# ── World Cup 2026 Fantasy mode (/wc) ────────────────────────────────────────

# Optional API-Football key (https://www.api-football.com, free tier 100 req/day)
# for confirmed starting lineups ~1h before kickoff. The WC dashboard degrades
# gracefully without it (lineup badges simply don't appear). Requests are
# budgeted via Redis (hard stop at 90/day) and lineups cached permanently.
API_FOOTBALL_KEY=

# Optional shared secret for /api/cron/* and /api/wc/cron/* routes. When set,
# requests must send "Authorization: Bearer <secret>". Vercel Cron sends this
# automatically when CRON_SECRET is configured in the project env.
CRON_SECRET=
